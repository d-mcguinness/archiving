# Copy to .env (or .env.local) and adjust per environment.
# Vite inlines VITE_* vars at BUILD time, so set these before `npm run build`.

# Backend base URL for REST calls (and the dev-server proxy target).
# Defaults to http://localhost:2020 when unset.
VITE_API_BASE=http://localhost:2020

# GraphQL endpoint. Defaults to /graphql (served via the dev proxy) when unset.
VITE_GRAPHQL_URI=http://localhost:2020/graphql

# Show the demo quick-login accounts on the login page (local only).
VITE_DEVMODE=true
