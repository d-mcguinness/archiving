      "description": "License terms for the object",
      "parent": "Rights",
      "children": [],
      "fields": [
        { "name": "licenseIdentifier", "type": "string", "label": "License ID" },
        { "name": "licenseTerms", "type": "string", "label": "License Terms" },
        { "name": "licenseNote", "type": "string", "label": "License Note" },
        { "name": "licenseStartDate", "type": "date", "label": "Start Date" },
        { "name": "licenseEndDate", "type": "date", "label": "End Date" }
      ]
    },
    {
      "name": "Statute",
      "type": "rights_type",
      "description": "Legal statute affecting the object",
      "parent": "Rights",
      "children": [],
      "fields": [
        { "name": "statuteJurisdiction", "type": "string", "label": "Jurisdiction" },
        { "name": "statuteCitation", "type": "string", "label": "Citation" },
        { "name": "statuteNote", "type": "string", "label": "Statute Note" },
        { "name": "statuteStartDate", "type": "date", "label": "Start Date" },
        { "name": "statuteEndDate", "type": "date", "label": "End Date" }
      ]
    },
    {
      "name": "Access Rights",
