      "parent": "Environment",
      "children": [],
      "fields": [
        { "name": "hardwareName", "type": "string", "label": "Hardware Name" },
        { "name": "hardwareType", "type": "string", "label": "Hardware Type" },
        { "name": "hardwareVersion", "type": "string", "label": "Version" },
        { "name": "hardwareNote", "type": "string", "label": "Hardware Note" }
      ]
    },
    {
      "name": "Software Environment",
      "type": "environment_type",
      "description": "Software specifications required",
      "parent": "Environment",
      "children": [],
      "fields": [
        { "name": "softwareName", "type": "string", "label": "Software Name" },
        { "name": "softwareVersion", "type": "string", "label": "Version" },
        { "name": "softwareType", "type": "string", "label": "Software Type" },
        { "name": "softwareDependency", "type": "string", "label": "Dependencies" }
      ]
    },
    {
      "name": "Environment Extension",
