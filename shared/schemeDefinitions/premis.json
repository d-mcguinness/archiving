      "children": ["Person", "Organization", "Software"],
      "fields": [
        { "name": "agentIdentifier", "type": "string", "label": "Agent Identifier" },
        { "name": "agentIdentifierType", "type": "string", "label": "Identifier Type" },
        { "name": "agentName", "type": "string", "label": "Agent Name" },
        { "name": "agentType", "type": "string", "label": "Agent Type" }
      ]
    },
