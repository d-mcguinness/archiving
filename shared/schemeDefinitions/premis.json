      "parent": "Agent",
      "children": [],
      "fields": [
        { "name": "organizationName", "type": "string", "label": "Organization Name" },
        { "name": "organizationIdentifier", "type": "string", "label": "Organization ID" },
        { "name": "organizationType", "type": "string", "label": "Type" },
        { "name": "address", "type": "string", "label": "Address" }
      ]
    },
    {
      "name": "Software",
      "type": "agent_type",
      "description": "Software application or system",
      "parent": "Agent",
      "children": [],
      "fields": [
        { "name": "softwareName", "type": "string", "label": "Software Name" },
        { "name": "softwareVersion", "type": "string", "label": "Version" },
        { "name": "softwareType", "type": "string", "label": "Type" },
        { "name": "vendor", "type": "string", "label": "Vendor" }
      ]
    },
    {
      "name": "Rights",
