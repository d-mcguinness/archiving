{
  "standard": "PREMIS",
  "fullName": "Preservation Metadata: Implementation Strategies",
  "reference": "PREMIS Data Dictionary 3.0",
  "description": "International standard for metadata to support the preservation of digital objects and ensure their long-term usability",
  "version": "3.0",
  "xsdReference": "https://www.loc.gov/standards/premis/premis.xsd",
  "url": "https://www.loc.gov/standards/premis/",
  "entities": [
    {
      "name": "Object",
      "type": "core_entity",
      "description": "Discrete unit of information in digital form subject to digital preservation",
      "parent": null,
      "children": ["Intellectual Entity", "Representation", "File", "Bitstream"],
      "note": "Root entity in PREMIS data model",
      "fields": [
        { "name": "objectIdentifier", "type": "string", "label": "Object Identifier" },
        { "name": "objectIdentifierType", "type": "string", "label": "Identifier Type" },
        { "name": "objectCategory", "type": "string", "label": "Object Category" },
        { "name": "preservationLevel", "type": "string", "label": "Preservation Level" }
      ]
    },
    {
      "name": "Intellectual Entity",
      "type": "object_type",
      "description": "Coherent set of content that is described as a unit (e.g., book, photograph, database)",
      "parent": "Object",
      "children": [],
      "fields": [
        { "name": "intellectualEntityIdentifier", "type": "string", "label": "IE Identifier" },
        { "name": "intellectualEntityType", "type": "string", "label": "IE Type" },
        { "name": "title", "type": "string", "label": "Title" },
        { "name": "creator", "type": "string", "label": "Creator" },
        { "name": "dateCreated", "type": "date", "label": "Date Created" }
      ]
    },
    {
      "name": "Representation",
      "type": "object_type",
      "description": "Set of files needed to render an Intellectual Entity",
      "parent": "Object",
      "children": ["File"],
      "fields": [
        { "name": "representationIdentifier", "type": "string", "label": "Representation ID" },
        { "name": "representationType", "type": "string", "label": "Representation Type" },
        { "name": "dateCreated", "type": "date", "label": "Date Created" },
        { "name": "creatingApplication", "type": "string", "label": "Creating Application" }
      ]
    },
    {
      "name": "File",
      "type": "object_type",
      "description": "Named and ordered sequence of bytes known to an operating system",
      "parent": "Representation",
      "children": ["Bitstream"],
      "fields": [
        { "name": "fileIdentifier", "type": "string", "label": "File Identifier" },
        { "name": "fileName", "type": "string", "label": "File Name" },
        { "name": "fileSize", "type": "number", "label": "File Size (bytes)" },
        { "name": "formatName", "type": "string", "label": "Format Name" },
        { "name": "formatVersion", "type": "string", "label": "Format Version" },
        { "name": "formatRegistryKey", "type": "string", "label": "PRONOM ID" },
        { "name": "dateCreated", "type": "date", "label": "Date Created" },
        { "name": "creatingApplication", "type": "string", "label": "Creating Application" }
      ]
    },
    {
      "name": "Bitstream",
      "type": "object_type",
      "description": "Contiguous or non-contiguous data within a file that has meaningful properties",
      "parent": "File",
      "children": [],
      "fields": [
        { "name": "bitstreamIdentifier", "type": "string", "label": "Bitstream ID" },
        { "name": "bitstreamSize", "type": "number", "label": "Size (bytes)" },
        { "name": "formatName", "type": "string", "label": "Format Name" },
        { "name": "formatVersion", "type": "string", "label": "Format Version" }
      ]
    },
    {
      "name": "Event",
      "type": "core_entity",
      "description": "Action that involves one or more Object entities and/or Agent entities",
      "parent": null,
      "children": [],
      "note": "Records preservation actions and changes",
      "fields": [
        { "name": "eventIdentifier", "type": "string", "label": "Event Identifier" },
        { "name": "eventType", "type": "string", "label": "Event Type" },
        { "name": "eventDateTime", "type": "date", "label": "Event Date/Time" },
        { "name": "eventDetail", "type": "string", "label": "Event Detail" },
        { "name": "eventOutcome", "type": "string", "label": "Event Outcome" },
        { "name": "eventOutcomeDetail", "type": "string", "label": "Outcome Detail" }
      ]
    },
    {
      "name": "Agent",
