      "parent": null,
      "children": ["Copyright", "License", "Statute", "Access Rights"],
      "fields": [
        { "name": "rightsIdentifier", "type": "string", "label": "Rights Identifier" },
        { "name": "rightsStatement", "type": "string", "label": "Rights Statement" },
        { "name": "rightsBasis", "type": "string", "label": "Rights Basis" },
        { "name": "rightsGranted", "type": "string", "label": "Rights Granted" }
      ]
    },
