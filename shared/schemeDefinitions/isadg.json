    },
    {
      "name": "Immediate Source of Acquisition",
      "type": "context_element",
      "description": "3.2.4 - Source and date of acquisition or transfer",
      "parent": "Context",
      "children": [],
      "fields": [
        { "name": "acquisitionSource", "type": "string", "label": "Source of Acquisition" },
        { "name": "acquisitionDate", "type": "date", "label": "Date of Acquisition" },
        { "name": "acquisitionMethod", "type": "string", "label": "Method of Acquisition" }
      ]
    },
    {
      "name": "Content and Structure",
      "type": "area",
      "description": "Area 3: Information about the subject matter and arrangement of the unit of description",
      "parent": "Archival Description",
      "children": ["Scope and Content", "Appraisal and Destruction", "Accruals", "System of Arrangement"],
      "fields": [
        { "name": "contentStructureID", "type": "string", "label": "Content and Structure ID" }
      ]
    },
    {
      "name": "Scope and Content",
      "type": "content_element",
      "description": "3.3.1 - Summary of scope and content of the unit of description",
      "parent": "Content and Structure",
      "children": [],
      "fields": [
        { "name": "scopeContent", "type": "string", "label": "Scope and Content" }
      ]
    },
    {
      "name": "Appraisal and Destruction",
      "type": "content_element",
      "description": "3.3.2 - Information about appraisal, scheduling, and destruction actions",
      "parent": "Content and Structure",
      "children": [],
      "fields": [
        { "name": "appraisalInfo", "type": "string", "label": "Appraisal Information" },
        { "name": "destructionInfo", "type": "string", "label": "Destruction Information" },
        { "name": "retentionPeriod", "type": "string", "label": "Retention Period" }
