      "name": "Description Control",
      "type": "area",
      "description": "Area 7: Information about how, when, and by whom the description was created",
      "parent": "Archival Description",
      "children": ["Archivist Note", "Rules or Conventions", "Date of Description"],
      "fields": [
        { "name": "descriptionControlID", "type": "string", "label": "Description Control ID" }
      ]
    },
    {
      "name": "Archivist Note",
      "type": "control_element",
      "description": "3.7.1 - Information about who prepared the description",
      "parent": "Description Control",
      "children": [],
      "fields": [
        { "name": "archivistName", "type": "string", "label": "Archivist Name" },
        { "name": "archivistNote", "type": "string", "label": "Archivist Note" }
      ]
    },
    {
      "name": "Rules or Conventions",
      "type": "control_element",
      "description": "3.7.2 - Standards or conventions used in preparing the description",
      "parent": "Description Control",
      "children": [],
      "fields": [
        { "name": "rulesConventions", "type": "string", "label": "Rules or Conventions" },
        { "name": "conventionCitation", "type": "string", "label": "Convention Citation" }
      ]
    },
    {
      "name": "Date of Description",
      "type": "control_element",
      "description": "3.7.3 - Date(s) when the description was prepared and/or revised",
      "parent": "Description Control",
      "children": [],
      "fields": [
        { "name": "descriptionDate", "type": "date", "label": "Date of Description" },
        { "name": "revisionDate", "type": "date", "label": "Revision Date" }
      ]
