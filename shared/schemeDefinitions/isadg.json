  "descriptionAreas": {
    "area1": "Identity Statement Area (3.1)",
    "area2": "Context Area (3.2)",
    "area3": "Content and Structure Area (3.3)",
    "area4": "Conditions of Access and Use Area (3.4)",
    "area5": "Allied Materials Area (3.5)",
    "area6": "Notes Area (3.6)",
    "area7": "Description Control Area (3.7)"
  },
  "requiredElements": {
    "3.1.1": "Reference code",
    "3.1.2": "Title",
    "3.1.3": "Date(s)",
    "3.1.4": "Level of description",
    "3.1.5": "Extent and medium of the unit of description"
