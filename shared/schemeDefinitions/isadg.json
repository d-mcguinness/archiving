    {
      "name": "Related Units of Description",
      "type": "related_element",
      "description": "3.5.3 - Information about related materials in other locations",
      "parent": "Allied Materials",
      "children": [],
      "fields": [
        { "name": "relatedUnits", "type": "string", "label": "Related Units" },
        { "name": "relationshipType", "type": "string", "label": "Relationship Type" }
