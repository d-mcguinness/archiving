    },
    {
      "name": "Existence of Copies",
      "type": "related_element",
      "description": "3.5.2 - Information about copies of the unit of description",
      "parent": "Allied Materials",
      "children": [],
      "fields": [
        { "name": "copiesLocation", "type": "string", "label": "Location of Copies" },
        { "name": "copiesNote", "type": "string", "label": "Copies Note" }
