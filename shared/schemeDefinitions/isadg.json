      "description": "Area 2: Information about the origin and custody of the unit of description",
      "parent": "Archival Description",
      "children": ["Name of Creator", "Administrative/Biographical History", "Archival History", "Immediate Source of Acquisition"],
      "fields": [
        { "name": "contextID", "type": "string", "label": "Context ID" }
      ]
    },
    {
      "name": "Name of Creator",
      "type": "context_element",
      "description": "3.2.1 - Entity(ies) responsible for creating the unit of description",
      "parent": "Context",
      "children": [],
      "fields": [
        { "name": "creatorName", "type": "string", "label": "Creator Name" },
        { "name": "creatorType", "type": "string", "label": "Creator Type" },
        { "name": "authorityIdentifier", "type": "string", "label": "Authority Identifier" }
      ]
    },
    {
      "name": "Administrative/Biographical History",
      "type": "context_element",
      "description": "3.2.2 - History of the creator(s) of the unit of description",
      "parent": "Context",
      "children": [],
      "fields": [
        { "name": "history", "type": "string", "label": "Administrative/Biographical History" },
        { "name": "historyType", "type": "string", "label": "History Type" }
      ]
    },
    {
      "name": "Archival History",
      "type": "context_element",
      "description": "3.2.3 - History of the custody of the unit of description",
      "parent": "Context",
      "children": [],
      "fields": [
        { "name": "archivalHistory", "type": "string", "label": "Archival History" },
        { "name": "custodialHistory", "type": "string", "label": "Custodial History" }
