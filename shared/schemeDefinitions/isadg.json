        { "name": "languageCode", "type": "string", "label": "Language Code (ISO 639-2)" },
        { "name": "scriptCode", "type": "string", "label": "Script Code (ISO 15924)" },
        { "name": "languageNote", "type": "string", "label": "Language Note" }
