{
  "standard": "ISAD(G)",
  "fullName": "General International Standard Archival Description",
  "reference": "ISAD(G) Second Edition",
  "description": "International standard for archival description developed by the International Council on Archives, providing general guidance for the preparation of archival descriptions",
  "version": "2.0",
  "xsdReference": "https://www.ica.org/en/isadg-general-international-standard-archival-description-second-edition",
  "url": "https://www.ica.org/standards/isad-g/",
  "entities": [
    {
      "name": "Archival Description",
      "type": "root_element",
      "description": "Complete archival description following ISAD(G) standard",
      "parent": null,
      "children": ["Identity Statement", "Context", "Content and Structure", "Conditions of Access and Use", "Allied Materials", "Notes", "Description Control"],
      "note": "Seven areas of description",
      "fields": [
        { "name": "descriptionID", "type": "string", "label": "Description ID" },
        { "name": "levelOfDescription", "type": "string", "label": "Level of Description" }
      ]
    },
    {
      "name": "Identity Statement",
      "type": "area",
      "description": "Area 1: Information essential for identifying the unit of description",
      "parent": "Archival Description",
      "children": ["Reference Code", "Title", "Date", "Level of Description", "Extent and Medium"],
      "note": "Essential identifying information",
      "fields": [
        { "name": "identityStatementID", "type": "string", "label": "Identity Statement ID" }
      ]
    },
    {
      "name": "Reference Code",
      "type": "identity_element",
      "description": "3.1.1 - Unique identifier for the unit of description",
      "parent": "Identity Statement",
      "children": [],
      "note": "Combination of country code, repository code, and local reference",
      "fields": [
        { "name": "countryCode", "type": "string", "label": "Country Code (ISO 3166)" },
        { "name": "repositoryCode", "type": "string", "label": "Repository Code" },
        { "name": "localReference", "type": "string", "label": "Local Reference" },
        { "name": "referenceCode", "type": "string", "label": "Complete Reference Code" }
      ]
    },
    {
      "name": "Title",
      "type": "identity_element",
      "description": "3.1.2 - Name of the unit of description",
      "parent": "Identity Statement",
      "children": [],
      "fields": [
        { "name": "title", "type": "string", "label": "Title" },
        { "name": "titleType", "type": "string", "label": "Title Type" }
      ]
    },
    {
      "name": "Date",
      "type": "identity_element",
      "description": "3.1.3 - Date(s) of creation of the unit of description",
      "parent": "Identity Statement",
      "children": [],
      "fields": [
        { "name": "dateExpression", "type": "string", "label": "Date Expression" },
        { "name": "dateType", "type": "string", "label": "Date Type" },
        { "name": "startDate", "type": "date", "label": "Start Date" },
        { "name": "endDate", "type": "date", "label": "End Date" },
        { "name": "certainty", "type": "string", "label": "Certainty" }
      ]
    },
    {
      "name": "Level of Description",
      "type": "identity_element",
      "description": "3.1.4 - Level of arrangement of the unit of description",
      "parent": "Identity Statement",
      "children": [],
      "fields": [
        { "name": "level", "type": "string", "label": "Level" }
      ]
    },
    {
      "name": "Extent and Medium",
      "type": "identity_element",
      "description": "3.1.5 - Physical or logical extent and medium of the unit of description",
      "parent": "Identity Statement",
      "children": [],
      "fields": [
        { "name": "extent", "type": "string", "label": "Extent" },
        { "name": "medium", "type": "string", "label": "Medium of the Unit" },
        { "name": "quantity", "type": "number", "label": "Quantity" },
        { "name": "unit", "type": "string", "label": "Unit of Measurement" }
      ]
    },
