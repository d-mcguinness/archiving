    {
      "name": "General Note",
      "type": "note_element",
      "description": "3.6.1 - Special information not fitting elsewhere",
      "parent": "Notes",
      "children": [],
      "fields": [
        { "name": "note", "type": "string", "label": "Note" },
        { "name": "noteType", "type": "string", "label": "Note Type" }
      ]
    },
