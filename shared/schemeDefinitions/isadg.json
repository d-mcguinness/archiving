    },
    {
      "name": "Accruals",
      "type": "content_element",
      "description": "3.3.3 - Information about anticipated additions to the unit of description",
      "parent": "Content and Structure",
      "children": [],
      "fields": [
        { "name": "accruals", "type": "string", "label": "Accruals" },
        { "name": "accrualPolicy", "type": "string", "label": "Accrual Policy" }
