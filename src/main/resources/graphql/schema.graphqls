# User Module Types
type User {
    id: ID!
    name: String!
    email: String!
    age: Int
}

input CreateUserInput {
    name: String!
    email: String!
    age: Int
}

# Tenancy Module Types
type Tenant {
    id: ID!
    name: String!
    domain: String!
    displayName: String
    description: String
    status: TenantStatus!
    plan: TenantPlan!
    createdAt: String!
    updatedAt: String
    ownerId: String!
    settings: TenantSettings
}

type TenantSettings {
    maxUsers: Int
    maxArchives: Int
    maxStorageBytes: String
    allowExternalSharing: Boolean
    enableAuditLog: Boolean
    timezone: String
    defaultLanguage: String
    customDomain: String
}

enum TenantStatus {
    ACTIVE
    INACTIVE
    SUSPENDED
    PENDING_ACTIVATION
    TRIAL
    EXPIRED
}

enum TenantPlan {
    FREE
    BASIC
    PROFESSIONAL
    ENTERPRISE
    CUSTOM
}

input CreateTenantInput {
    name: String!
    domain: String!
    displayName: String
    description: String
    ownerId: String!
    plan: TenantPlan!
}

input UpdateTenantInput {
    tenantId: ID!
    name: String
    displayName: String
    description: String
    status: TenantStatus
    plan: TenantPlan
}

# Archive Module Types
type Archive {
    id: ID!
    tenantId: ID!
    ownerId: ID!
    tenant: Tenant
    title: String!
    description: String
    content: String!
    createdAt: String!
    updatedAt: String
    status: ArchiveStatus!
    standard: ArchiveStandard!
    rootElement: Element
    assignedUsers: [User!]!
}

# Element Type - represents actual instances in archive hierarchy
type Element {
    id: ID!
    archive: Archive
    parent: Element
    children: [Element!]!
    fields: [Field!]!
    elementIdentifier: String!
    entityName: String!
    entityType: String!
    norwegianName: String
    englishName: String
    title: String!
    description: String
    createdAt: String!
    createdBy: String
    updatedAt: String
    updatedBy: String
    closedAt: String
    closedBy: String
    status: String!
    sortOrder: Int
    metadata: String
    isRoot: Boolean!
    path: String
    depth: Int
    isLeaf: Boolean
    descendantsCount: Int
}

# Field Type - represents metadata fields for elements
type Field {
    id: ID!
    element: Element!
    name: String!
    label: String
    type: String!
    value: String
}


enum ArchiveStatus {
    DRAFT
    PUBLISHED
    ARCHIVED
    DELETED
}

enum ArchiveStandard {
    NOARK5
    OAIS
    PREMIS
    DUBLIN_CORE
    METS
    EAD
    BAGIT
    ISADG
    MODS
}

input CreateArchiveInput {
    tenantId: ID
    ownerId: ID
    userId: ID!
    title: String!
    description: String
    content: String!
    standard: ArchiveStandard!
}

input UpdateArchiveInput {
    title: String!
    description: String
    content: String!
    status: ArchiveStatus!
}

input CreateElementInput {
    archiveId: ID!
    parentElementId: ID
    elementIdentifier: String!
    entityName: String!
    entityType: String!
    norwegianName: String
    englishName: String
    title: String!
    description: String
    createdBy: String!
    fields: [FieldInput!]
}

input FieldInput {
    name: String!
    label: String
    type: String!
    value: String
}

input UpdateElementInput {
    title: String!
    description: String
    updatedBy: String!
}

input AssignUserInput {
    archiveId: ID!
    userId: ID!
}

input UnassignUserInput {
    archiveId: ID!
    userId: ID!
}

# SIP Module Types
type Sip {
    id: ID!
    tenantId: ID!
    ownerId: ID!
    tenant: Tenant
    title: String!
    description: String
    content: String
    createdAt: String!
    updatedAt: String
    status: SipStatus!
    standard: ArchiveStandard!
    rootElement: Element
    assignedUsers: [User!]!
}

enum SipStatus {
    DRAFT
    SUBMITTED
    VALIDATED
    ACCEPTED
    REJECTED
}

input CreateSipInput {
    tenantId: ID
    ownerId: ID
    userId: ID!
    title: String!
    description: String
    content: String
    standard: ArchiveStandard!
    elementIdentifier: String!
    entityName: String!
    entityType: String!
    norwegianName: String
    englishName: String
    elementTitle: String!
    elementDescription: String
    createdBy: String!
    fields: [FieldInput!]
}

# Dashboard Types
type DashboardStats {
    totalUsers: Int!
    totalTenants: Int!
    totalArchives: Int!
    activeArchives: Int!
    draftArchives: Int!
    archivedArchives: Int!
}

type TenantDashboardStats {
    tenantId: ID
    tenantName: String
    tenantStatus: String
    tenantPlan: String
    totalUsers: Int!
    totalArchives: Int!
    activeArchives: Int!
    draftArchives: Int!
    archivedArchives: Int!
}

# Pagination Types
type PageInfo {
    number: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
    hasNext: Boolean!
    hasPrevious: Boolean!
    isFirst: Boolean!
    isLast: Boolean!
}

type ArchivePage {
    content: [Archive!]!
    pageInfo: PageInfo!
    empty: Boolean!
}

# Root Query Type
type Query {
    # Dashboard Queries
    getDashboardStats: DashboardStats!
    getTenantDashboardStats(tenantId: ID!): TenantDashboardStats!

    # User Queries
    getAllUsers: [User!]!
    getUser(id: ID!): User

    # Tenancy Queries
    getAllTenants: [Tenant!]!
    getTenant(id: ID!): Tenant
    getTenantsByStatus(status: TenantStatus!): [Tenant!]!
    getTenantsByOwner(ownerId: ID!): [Tenant!]!

    # Archive Queries
    getAllArchives: [Archive!]!
    getArchive(id: ID!): Archive
    getArchivesByUser(userId: ID!): [Archive!]!
    getArchivesByOwner(ownerId: ID!): [Archive!]!
    getArchivesByTenant(tenantId: ID!): [Archive!]!
    getAllSips: [Archive!]!
    getSipsByTenant(tenantId: ID!): [Archive!]!
    getArchivesByUserAssignment(userId: ID!): [Archive!]!

    # Archive Paginated Queries (Recommended for scalability)
    getAllArchivesPaginated(page: Int, size: Int, sortBy: String, sortDirection: String): ArchivePage!
    getArchivesByUserPaginated(userId: ID!, page: Int, size: Int, sortBy: String, sortDirection: String): ArchivePage!
    getArchivesByUserAssignmentPaginated(userId: ID!, page: Int, size: Int, sortBy: String, sortDirection: String): ArchivePage!
    getArchivesByStatusPaginated(status: ArchiveStatus!, page: Int, size: Int, sortBy: String, sortDirection: String): ArchivePage!
    searchArchivesByTitlePaginated(title: String!, page: Int, size: Int, sortBy: String, sortDirection: String): ArchivePage!


    # SIP Queries
    getAllSipsV2: [Sip!]!
    getSipsByTenantV2(tenantId: ID!): [Sip!]!
    getSip(id: ID!): Sip

    # Element Queries
    getElement(id: ID!): Element
    getElementsByArchive(archiveId: ID!): [Element!]!
    getRootElements(archiveId: ID!): [Element!]!
    getElementChildren(elementId: ID!): [Element!]!
    getElementByIdentifier(archiveId: ID!, elementIdentifier: String!): Element
    searchElements(archiveId: ID!, searchTerm: String!): [Element!]!
    getElementsByStatus(archiveId: ID!, status: String!): [Element!]!
    getElementHierarchy(archiveId: ID!): [Element!]!
    getLeafElements(archiveId: ID!): [Element!]!
    countElements(archiveId: ID!): Int!
}

# Root Mutation Type
type Mutation {
    # User Mutations
    createUser(input: CreateUserInput!): User!
    updateUser(id: ID!, input: CreateUserInput!): User
    deleteUser(id: ID!): Boolean!

    # Tenancy Mutations
    createTenant(input: CreateTenantInput!): Tenant!
    updateTenant(input: UpdateTenantInput!): Tenant!
    addUserToTenant(userId: ID!, tenantId: ID!): Boolean!
    removeUserFromTenant(userId: ID!): Boolean!
    deleteTenant(id: ID!): Boolean!

    # Archive Mutations
    createArchive(input: CreateArchiveInput!): Archive!
    updateArchive(id: ID!, input: UpdateArchiveInput!): Archive!
    updateArchiveStatus(archiveId: ID!, status: ArchiveStatus!): Archive
    setArchiveRootElement(archiveId: ID!, rootElementId: ID!): Archive!
    deleteArchive(id: ID!): Boolean!

    # User Assignment Mutations
    assignUserToArchive(input: AssignUserInput!): Archive!
    unassignUserFromArchive(input: UnassignUserInput!): Archive!

    # SIP Mutations
    createSipV2(input: CreateSipInput!): Sip!
    generateSip(sipId: ID!): String!
    updateSipStatusV2(sipId: ID!, status: SipStatus!): Sip
    deleteSipV2(id: ID!): Boolean!

    # Element Mutations
    createElement(input: CreateElementInput!): Element!
    updateElement(id: ID!, input: UpdateElementInput!, fields: [FieldInput!]): Element!
    updateElementStatus(id: ID!, status: String!, updatedBy: String!): Element!
    closeElement(id: ID!, closedBy: String!): Element!
    deleteElement(id: ID!): Boolean!
    moveElement(elementId: ID!, newParentId: ID, updatedBy: String!): Element!
}
