# User Module Types
type User {
    id: ID!
    name: String!
    email: String!
    age: Int
}

input CreateUserInput {
    name: String!
    email: String!
    age: Int
}

# Tenancy Module Types
type Tenant {
    id: ID!
    name: String!
    domain: String!
    displayName: String
    description: String
    status: TenantStatus!
    plan: TenantPlan!
    createdAt: String!
    updatedAt: String
    ownerId: String!
    settings: TenantSettings
}

type TenantSettings {
    maxUsers: Int
    maxArchives: Int
    maxStorageBytes: String
    allowExternalSharing: Boolean
    enableAuditLog: Boolean
    timezone: String
    defaultLanguage: String
    customDomain: String
}

enum TenantStatus {
    ACTIVE
    INACTIVE
    SUSPENDED
    PENDING_ACTIVATION
    TRIAL
    EXPIRED
}

enum TenantPlan {
    FREE
    BASIC
    PROFESSIONAL
    ENTERPRISE
    CUSTOM
}

input CreateTenantInput {
    name: String!
    domain: String!
    displayName: String
    description: String
    ownerId: String!
    plan: TenantPlan!
}

input UpdateTenantInput {
    tenantId: ID!
    name: String
    displayName: String
    description: String
    status: TenantStatus
    plan: TenantPlan
}

# Archive Module Types
type Archive {
    id: ID!
    tenantId: ID!
    ownerId: ID!
    tenant: Tenant
    title: String!
    description: String
    content: String!
    createdAt: String!
    updatedAt: String
    status: ArchiveStatus!
    standard: ArchiveStandard!
    rootElement: Element
    assignedUsers: [User!]!
}

# Element Type - represents actual instances in archive hierarchy
type Element {
    id: ID!
    archive: Archive
    parent: Element
    children: [Element!]!
    fields: [Field!]!
    outgoingLinks: [ElementLink!]!
    incomingLinks: [ElementLink!]!
    elementIdentifier: String!
    entityName: String!
    entityType: String!
    norwegianName: String
    englishName: String
    title: String!
    description: String
    createdAt: String!
    createdBy: String
    updatedAt: String
    updatedBy: String
    closedAt: String
    closedBy: String
    status: String!
    sortOrder: Int
    metadata: String
    isRoot: Boolean!
    path: String
    depth: Int
    isLeaf: Boolean
}

type ElementLink {
    id: ID!
    sourceElement: Element!
    targetElement: Element!
    linkType: String!
    label: String
    description: String
    directional: Boolean!
    metadata: String
    createdAt: String!
    createdBy: String
}

input CreateElementLinkInput {
    sourceElementId: ID!
    targetElementId: ID!
    linkType: String!
    label: String
    description: String
    directional: Boolean
    createdBy: String
}

# Field Type - represents metadata fields for elements
type Field {
    id: ID!
    element: Element!
    name: String!
    label: String
    type: String!
    value: String
}


enum ArchiveStatus {
    DRAFT
    PUBLISHED
    ARCHIVED
    DELETED
}

enum ArchiveStandard {
    NOARK5
    OAIS
    PREMIS
    DUBLIN_CORE
    METS
    EAD
    BAGIT
    ISADG
    MODS
    EARK
}

input CreateArchiveInput {
    tenantId: ID
    ownerId: ID
    userId: ID!
    title: String!
    description: String
    content: String!
    standard: ArchiveStandard!
}

input UpdateArchiveInput {
    title: String!
    description: String
    content: String!
    status: ArchiveStatus!
}

input CreateElementInput {
    archiveId: ID!
    parentElementId: ID
    elementIdentifier: String!
    entityName: String!
    entityType: String!
    norwegianName: String
    englishName: String
    title: String!
    description: String
    createdBy: String!
    fields: [FieldInput!]
}

input AddChildElementInput {
    elementIdentifier: String!
    entityName: String!
    entityType: String!
    norwegianName: String
    englishName: String
    title: String!
    description: String
    createdBy: String!
    fields: [FieldInput!]
}

input FieldInput {
    name: String!
    label: String
    type: String!
    value: String
}

input UpdateElementInput {
    title: String!
    description: String
    updatedBy: String!
}

input AssignUserInput {
    archiveId: ID!
    userId: ID!
}

input UnassignUserInput {
    archiveId: ID!
    userId: ID!
}

# INTAKE Module Types
type Intake {
    id: ID!
    tenantId: ID!
    ownerId: ID!
    archiveId: ID
    tenant: Tenant
    title: String!
    description: String
    content: String
    createdAt: String!
    updatedAt: String
    status: IntakeStatus!
    standard: ArchiveStandard!
    rootElement: Element
    assignedUsers: [User!]!
}

enum IntakeStatus {
    DRAFT
    SUBMITTED
    VALIDATED
    ACCEPTED
    REJECTED
}

input CreateIntakeInput {
    tenantId: ID
    ownerId: ID
    archiveId: ID!
    userId: ID!
    title: String!
    description: String
    content: String
    standard: ArchiveStandard!
    elementIdentifier: String!
    entityName: String!
    entityType: String!
    norwegianName: String
    englishName: String
    elementTitle: String!
    elementDescription: String
    createdBy: String!
    fields: [FieldInput!]
}

# PRESERVATION Module Types
type Preservation {
    id: ID!
    tenantId: ID!
    ownerId: ID!
    tenant: Tenant
    title: String!
    description: String
    content: String
    createdAt: String!
    updatedAt: String
    status: PreservationStatus!
    standard: ArchiveStandard!
    sourceIntakeId: ID
    rootElement: Element
    assignedUsers: [User!]!
}

enum PreservationStatus {
    DRAFT
    BUILDING
    VALIDATED
    STORED
    REJECTED
}

input CreatePreservationInput {
    tenantId: ID
    ownerId: ID
    userId: ID!
    title: String!
    description: String
    content: String
    standard: ArchiveStandard!
    sourceIntakeId: ID
    elementIdentifier: String!
    entityName: String!
    entityType: String!
    norwegianName: String
    englishName: String
    elementTitle: String!
    elementDescription: String
    createdBy: String!
    fields: [FieldInput!]
}

# RELEASE Module Types
type Release {
    id: ID!
    tenantId: ID!
    ownerId: ID!
    tenant: Tenant
    title: String!
    description: String
    content: String
    createdAt: String!
    updatedAt: String
    status: ReleaseStatus!
    standard: ArchiveStandard!
    sourcePreservationId: ID
    rootElement: Element
    assignedUsers: [User!]!
}

enum ReleaseStatus {
    DRAFT
    PREPARED
    DISSEMINATED
    EXPIRED
    REJECTED
}

input CreateReleaseInput {
    tenantId: ID
    ownerId: ID
    userId: ID!
    title: String!
    description: String
    content: String
    standard: ArchiveStandard!
    sourcePreservationId: ID
    elementIdentifier: String!
    entityName: String!
    entityType: String!
    norwegianName: String
    englishName: String
    elementTitle: String!
    elementDescription: String
    createdBy: String!
    fields: [FieldInput!]
}

# Dashboard Types
type DashboardStats {
    totalUsers: Int!
    totalTenants: Int!
    totalArchives: Int!
    activeArchives: Int!
    draftArchives: Int!
    archivedArchives: Int!
}

type TenantDashboardStats {
    tenantId: ID
    tenantName: String
    tenantStatus: String
    tenantPlan: String
    totalUsers: Int!
    totalArchives: Int!
    activeArchives: Int!
    draftArchives: Int!
    archivedArchives: Int!
}

# Pagination Types
type PageInfo {
    number: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
    hasNext: Boolean!
    hasPrevious: Boolean!
    isFirst: Boolean!
    isLast: Boolean!
}

type ArchivePage {
    content: [Archive!]!
    pageInfo: PageInfo!
    empty: Boolean!
}

# Root Query Type
# Unified Package Types
enum PackageStage { INTAKE, PRESERVATION, RELEASE }

enum PackageStatus {
    DRAFT, SUBMITTED, VALIDATED, ACCEPTED, REJECTED,
    BUILDING, STORED, PREPARED, DISSEMINATED, EXPIRED
}

type ArchivalPackage {
    id: ID!
    tenantId: ID!
    ownerId: ID!
    title: String!
    description: String
    content: String
    createdAt: String!
    updatedAt: String
    stage: PackageStage!
    status: PackageStatus!
    standard: ArchiveStandard!
    sourceArchiveId: ID
    sourcePackageId: ID
    rootElement: Element
    assignedUsers: [User!]!
}

input CreatePackageInput {
    tenantId: ID
    ownerId: ID
    userId: ID!
    title: String!
    description: String
    content: String
    stage: PackageStage!
    standard: ArchiveStandard!
    sourceArchiveId: ID
    sourcePackageId: ID
    elementIdentifier: String!
    entityName: String!
    entityType: String!
    norwegianName: String
    englishName: String
    elementTitle: String!
    elementDescription: String
    createdBy: String!
    fields: [FieldInput!]
}

input FileMetadataInput {
    filename: String!
    contentType: String!
    fileSize: String!
    checksum: String!
    uploadedAt: String!
    uploaderName: String!
    fileCount: Int!
}

type PrefillField {
    name: String!
    value: String!
}

type Query {
    # Dashboard Queries
    getDashboardStats: DashboardStats!
    getTenantDashboardStats(tenantId: ID!): TenantDashboardStats!

    # User Queries
    getAllUsers: [User!]!
    getUser(id: ID!): User

    # Tenancy Queries
    getAllTenants: [Tenant!]!
    getTenant(id: ID!): Tenant
    getTenantsByStatus(status: TenantStatus!): [Tenant!]!
    getTenantsByOwner(ownerId: ID!): [Tenant!]!

    # Archive Queries
    getAllArchives: [Archive!]!
    getArchive(id: ID!): Archive
    getArchivesByUser(userId: ID!): [Archive!]!
    getArchivesByOwner(ownerId: ID!): [Archive!]!
    getArchivesByTenant(tenantId: ID!): [Archive!]!
    getAllIntakes: [Archive!]!
    getIntakesByTenant(tenantId: ID!): [Archive!]!
    getArchivesByUserAssignment(userId: ID!): [Archive!]!

    # Archive Paginated Queries (Recommended for scalability)
    getAllArchivesPaginated(page: Int, size: Int, sortBy: String, sortDirection: String): ArchivePage!
    getArchivesByUserPaginated(userId: ID!, page: Int, size: Int, sortBy: String, sortDirection: String): ArchivePage!
    getArchivesByUserAssignmentPaginated(userId: ID!, page: Int, size: Int, sortBy: String, sortDirection: String): ArchivePage!
    getArchivesByStatusPaginated(status: ArchiveStatus!, page: Int, size: Int, sortBy: String, sortDirection: String): ArchivePage!
    searchArchivesByTitlePaginated(title: String!, page: Int, size: Int, sortBy: String, sortDirection: String): ArchivePage!


    # INTAKE Queries
    getAllIntakesV2: [Intake!]!
    getIntakesByTenantV2(tenantId: ID!): [Intake!]!
    getIntake(id: ID!): Intake
    prefillIntakeFields(standard: ArchiveStandard!, fileMetadata: FileMetadataInput!): [PrefillField!]!

    # PRESERVATION Queries
    getAllPreservations: [Preservation!]!
    getPreservationsByTenant(tenantId: ID!): [Preservation!]!
    getPreservation(id: ID!): Preservation

    # RELEASE Queries
    getAllReleases: [Release!]!
    getReleasesByTenant(tenantId: ID!): [Release!]!
    getRelease(id: ID!): Release

    # Package Queries (unified INTAKE/PRESERVATION/RELEASE)
    getAllPackages(stage: PackageStage): [ArchivalPackage!]!
    getPackagesByTenant(tenantId: ID!, stage: PackageStage): [ArchivalPackage!]!
    getPackage(id: ID!): ArchivalPackage

    # Element Link Queries
    getElementLinks(elementId: ID!): [ElementLink!]!
    getOutgoingLinks(elementId: ID!): [ElementLink!]!
    getIncomingLinks(elementId: ID!): [ElementLink!]!

    # Element Queries
    getElement(id: ID!): Element
    getElementsByArchive(archiveId: ID!): [Element!]!
    getRootElements(archiveId: ID!): [Element!]!
    getElementChildren(elementId: ID!): [Element!]!
    getElementByIdentifier(archiveId: ID!, elementIdentifier: String!): Element
    searchElements(archiveId: ID!, searchTerm: String!): [Element!]!
    getElementsByStatus(archiveId: ID!, status: String!): [Element!]!
    getElementHierarchy(archiveId: ID!): [Element!]!
    getLeafElements(archiveId: ID!): [Element!]!
    countElements(archiveId: ID!): Int!
}

# Root Mutation Type
type Mutation {
    # User Mutations
    createUser(input: CreateUserInput!): User!
    updateUser(id: ID!, input: CreateUserInput!): User
    deleteUser(id: ID!): Boolean!

    # Tenancy Mutations
    createTenant(input: CreateTenantInput!): Tenant!
    updateTenant(input: UpdateTenantInput!): Tenant!
    addUserToTenant(userId: ID!, tenantId: ID!): Boolean!
    removeUserFromTenant(tenantId: ID!, userId: ID!): Boolean!
    deleteTenant(id: ID!): Boolean!

    # Archive Mutations
    createArchive(input: CreateArchiveInput!): Archive!
    updateArchive(id: ID!, input: UpdateArchiveInput!): Archive!
    updateArchiveStatus(archiveId: ID!, status: ArchiveStatus!): Archive
    setArchiveRootElement(archiveId: ID!, rootElementId: ID!): Archive!
    deleteArchive(id: ID!): Boolean!

    # User Assignment Mutations
    assignUserToArchive(input: AssignUserInput!): Archive!
    unassignUserFromArchive(input: UnassignUserInput!): Archive!

    # INTAKE Mutations
    createIntakeV2(input: CreateIntakeInput!): Intake!
    generateIntake(intakeId: ID!): String!
    updateIntakeStatusV2(intakeId: ID!, status: IntakeStatus!): Intake
    deleteIntakeV2(id: ID!): Boolean!

    # PRESERVATION Mutations
    createPreservation(input: CreatePreservationInput!): Preservation!
    generatePreservation(preservationId: ID!): String!
    updatePreservationStatus(preservationId: ID!, status: PreservationStatus!): Preservation
    deletePreservation(id: ID!): Boolean!

    # RELEASE Mutations
    createRelease(input: CreateReleaseInput!): Release!
    generateRelease(releaseId: ID!): String!
    updateReleaseStatus(releaseId: ID!, status: ReleaseStatus!): Release
    deleteRelease(id: ID!): Boolean!

    # Package Mutations (unified INTAKE/PRESERVATION/RELEASE)
    createPackage(input: CreatePackageInput!): ArchivalPackage!
    updatePackageStatus(packageId: ID!, status: PackageStatus!): ArchivalPackage
    deletePackage(id: ID!): Boolean!

    # Element Link Mutations
    createElementLink(input: CreateElementLinkInput!): ElementLink!
    deleteElementLink(id: ID!): Boolean!

    # Element Mutations
    createElement(input: CreateElementInput!): Element!
    addChildElement(parentElementId: ID!, input: AddChildElementInput!): Element!
    updateElement(id: ID!, input: UpdateElementInput!, fields: [FieldInput!]): Element!
    updateElementStatus(id: ID!, status: String!, updatedBy: String!): Element!
    closeElement(id: ID!, closedBy: String!): Element!
    deleteElement(id: ID!): Boolean!
    moveElement(elementId: ID!, newParentId: ID, updatedBy: String!): Element!
}
